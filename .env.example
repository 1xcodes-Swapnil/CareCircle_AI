# Environment Variables — CareCircle AI
# Copy this file to .env and fill in all values before running the application.
# NEVER commit your .env file to version control.

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# The port the Express server listens on. Defaults to 3000.
PORT=3000

# Node environment. Use 'development' locally, 'production' for deployments.
NODE_ENV=development

# =============================================================================
# AUTHENTICATION
# =============================================================================

# REQUIRED: Secret key used to sign session tokens (JWT-style HMAC-SHA256).
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The application will NOT function if this variable is missing.
JWT_SECRET=your_jwt_secret_key_here_generate_a_strong_random_value

# =============================================================================
# GOOGLE GEMINI AI
# =============================================================================

# REQUIRED for AI features: Your Google Gemini API key.
# Obtain from: https://aistudio.google.com/app/apikey
# If not set, the system falls back to the local clinical rules engine.
GEMINI_API_KEY=your_google_gemini_api_key_here

# =============================================================================
# REDIS (Background Queue Processing & Caching)
# =============================================================================

# Redis connection settings. Required for BullMQ background workers and caching.
# For local development, Redis defaults to localhost:6379 with no password.
# For production, use a managed Redis service (e.g., Redis Cloud, AWS ElastiCache).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USE_TLS=false

# =============================================================================
# APPLICATION
# =============================================================================

# The publicly accessible URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoint references.
APP_URL=http://localhost:3000

# Set to 'true' to enable demo persona quick-login in the UI.
# DISABLE IN PRODUCTION for real deployments with real user data.
ALLOW_DEMO_LOGIN=true
